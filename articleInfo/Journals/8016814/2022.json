        "articleTitle": "Breaking the Tie: Benacerraf's Identification Argument Revisited",
        "volume": "31",
        "issue": "1",
        "startPage": "81",
        "endPage": "103",
        "publisher": "OUP",
        "articleContentType": "Journals",
