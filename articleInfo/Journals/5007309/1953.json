        "articleTitle": "Automatic Reduction of Wind Tunnel Data",
        "volume": "PGI-2",
        "issue": null,
        "startPage": "39",
        "endPage": "47",
        "publisher": "IEEE",
        "articleContentType": "Journals",
        "publicationTitle": "Transactions of the IRE Professional Group on Instrumentation",
        "authors": [
            {
                "id": 37319122300,
                "preferredName": "Haneman",
                "firstName": null,
                "lastName": "Haneman"
            },
            {
                "id": 37319121300,
                "preferredName": "Rauch",
                "firstName": null,
                "lastName": "Rauch"
            },
            {
                "id": 37319122900,
