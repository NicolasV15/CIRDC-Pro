        "articleTitle": "Transistorized Switching Control of a Variable-Speed DC Motor",
        "volume": "IE-8",
        "issue": "1",
        "startPage": "19",
        "endPage": "24",
        "publisher": "IEEE",
        "articleContentType": "Journals",
        "publicationTitle": "IRE Transactions on Industrial Electronics",
        "authors": [
            {
