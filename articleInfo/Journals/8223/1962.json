        "articleNumber": "1136316",
        "articleTitle": "Advanced Procedures for Development of Weld Schedules",
        "volume": "6",
        "issue": "4",
        "startPage": "15",
        "endPage": "15",
        "publisher": "IEEE",
        "articleContentType": "Journals",
