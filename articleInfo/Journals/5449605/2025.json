        "articleTitle": "Situation-aware deep reinforcement learning for autonomous nonlinear mobility control in cyber-physical loitering munition systems",
        "volume": "27",
        "issue": "1",
        "startPage": "10",
        "endPage": "22",
        "publisher": "KICS",
        "articleContentType": "Journals",
        "publicationTitle": "Journal of Communications and Networks",
        "authors": [
            {
                "id": 37089254516,
                "preferredName": "Hyunsoo Lee",
                "firstName": "Hyunsoo",
                "lastName": "Lee"
            },
            {
                "id": 775735638967235,
                "preferredName": "Soyi Jung",
