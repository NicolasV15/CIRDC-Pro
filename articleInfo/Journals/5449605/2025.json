        "articleTitle": "Transformer-enabled hybrid precoding for TDD large-scale antenna arrays systems with channel sensing",
        "volume": "27",
        "issue": "1",
        "startPage": "23",
        "endPage": "31",
        "publisher": "KICS",
        "articleContentType": "Journals",
        "publicationTitle": "Journal of Communications and Networks",
        "authors": [
