        "articleTitle": "Interregional Value-Added Tax in the Era of E-Commerce: Tax Policy Design Based on Big Data from Online Retailing",
        "volume": "5",
        "issue": "1",
        "startPage": "46",
        "endPage": "57",
        "publisher": "TUP",
        "articleContentType": "Journals",
        "publicationTitle": "Journal of Social Computing",
        "authors": [
            {
                "id": 972804569425648,
                "preferredName": "Yu Chen",
                "firstName": "Yu",
                "lastName": "Chen"
            },
            {
                "id": 789496005324908,
