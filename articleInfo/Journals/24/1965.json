        "articleTitle": "Insufficiency of Instantaneous Strength Determinations for Failure Rate Prediction",
        "volume": "R-14",
        "issue": "2",
        "startPage": "77",
        "endPage": "83",
        "publisher": "IEEE",
        "articleContentType": "Journals",
