        "articleTitle": "The Birth of an ERA: Engineering Associates, Inc. 1946-1955",
        "volume": "1",
        "issue": "2",
        "startPage": "83",
        "endPage": "97",
        "publisher": "IEEE",
        "articleContentType": "Magazines",
        "publicationTitle": "Annals of the History of Computing",
        "authors": [
            {
                "id": 37691762400,
