        "articleNumber": "1135334",
        "articleTitle": "The Economics of Automation --- Some Important Considerations",
        "volume": "1",
        "issue": "1",
        "startPage": "34",
        "endPage": "37",
        "publisher": "IEEE",
        "articleContentType": "Journals",
        "publicationTitle": "IRE Transactions on Production Techniques",
