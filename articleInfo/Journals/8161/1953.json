        "articleTitle": "Twinplex, Twinmode, and Polyplex Radiotelegraph Systems",
        "volume": "1",
        "issue": "1",
        "startPage": "65",
        "endPage": "65",
        "publisher": "IEEE",
        "articleContentType": "Journals",
        "publicationTitle": "Transactions of the IRE Professional Group on Communications Systems",
