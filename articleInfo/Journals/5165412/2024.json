        "articleTitle": "One Trillion True Random Bits Generated with a Field Programmable Gate Array Actuated Magnetic Tunnel Junction",
        "volume": "PP",
        "issue": "99",
        "startPage": "1",
        "endPage": "5",
        "publisher": "IEEE",
