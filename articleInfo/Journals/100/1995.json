        "volume": "2",
        "issue": "1",
        "startPage": "18",
        "endPage": "26",
        "publisher": "IEEE",
        "articleContentType": "Magazines",
        "publicationTitle": "IEEE Robotics & Automation Magazine",
        "authors": [
            {
