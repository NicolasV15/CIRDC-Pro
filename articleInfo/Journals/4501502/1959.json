        "articleTitle": "Optimized Compatible AM Stereo Broadcast System",
        "volume": "PGBC-14",
        "issue": "0",
        "startPage": "2",
        "endPage": "15",
        "publisher": "IEEE",
        "articleContentType": "Journals",
        "publicationTitle": "IRE Transactions on Broadcasting",
        "authors": [
            {
                "id": 38080563800,
                "preferredName": "H. B. Collins",
                "firstName": "H. B.",
