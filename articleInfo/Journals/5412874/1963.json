        "articleTitle": "Printed Circuit Motors for High-Speed Incrementing of Inertial and Dissipative Loads",
        "volume": "IE-10",
        "issue": "1",
        "startPage": "28",
        "endPage": "45",
        "publisher": "IEEE",
