        "startPage": "27",
        "endPage": "34",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 Workshop on Fault Diagnosis and Tolerance in Cryptography (FDTC)",
        "authors": [
            {
