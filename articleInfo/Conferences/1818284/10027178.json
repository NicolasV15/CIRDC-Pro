        "articleTitle": "Compressed In-memory Graphs for Accelerating GPU-based Analytics",
        "volume": null,
        "issue": null,
        "startPage": "32",
        "endPage": "40",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2022 IEEE/ACM Workshop on Irregular Applications: Architectures and Algorithms (IA3)",
        "authors": [
            {
                "id": 37089434754,
