    {
        "publicationNumber": "4360004",
        "doi": null,
        "publicationYear": "2007",
        "publicationDate": "10-11 Sept. 2007",
        "articleNumber": "4360022",
        "articleTitle": "A new approach to partial discharge measurements for testing electrical insulation systems",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "33",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "2007 IET Power Convention",
        "authors": [
            {
                "id": null,
                "preferredName": "Brian G Stewart",
                "firstName": "Brian G",
                "lastName": "Stewart"
            }
        ],
        "abstract": "This article consists only of a collection of slides from the author's conference presentation. some of the conclusions noted are: It is possible to potentially discriminate between different PD mechanisms/sources/faults using correlation plots of simultaneous RF energy and IEC60270 \"apparent charge\". Different PD fault geometries produce distinctly different characteristic correlation curves/clusters. Results clearly show that different PD fault geometries have different RF energy characteristics and therefore different physical mechanisms (charge movement/rise time etc.) when considered with the apparent charge measure. The correlation coefficient, R, associated with the correlation plots appears to be PD sample dependent and thus a potential further parameter for PD source discrimination. Correlation plots of frequency band energy against apparent charge also produces relative frequency band information which also appears to be PD source dependent. Relative frequency information will provide key information on the physical mechanisms. Application of combined technique to HV plant items is critical to validate and extend the combined measurement strategy.",
        "keywords": {
            "Index Terms": [
                "Physical Mechanisms",
                "Correlation Plots",
                "Free Particles",
                "Energy Plot",
                "RF Energy",
                "Apparent Charge"
            ]
        }
    },
