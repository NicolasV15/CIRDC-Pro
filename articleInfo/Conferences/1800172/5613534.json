        "articleTitle": "Run-time monitoring of system performance: A goal-oriented and system architecture simulation approach",
        "volume": null,
        "issue": null,
        "startPage": "31",
        "endPage": "40",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2010 First International Workshop on Requirements@Run.Time",
        "authors": [
            {
                "id": 37392869900,
                "preferredName": "Tom Hill",
