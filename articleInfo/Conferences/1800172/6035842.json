        "articleTitle": "Dealing with softgoals at runtime: A fuzzy logic approach",
        "volume": null,
        "issue": null,
        "startPage": "23",
        "endPage": "31",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2011 2nd International Workshop on Requirements@Run.Time",
        "authors": [
