        "articleTitle": "Experimental Testing of Regulations for AI-systems in Russia (using drones and unmanned vehicles as examples",
        "volume": null,
        "issue": null,
        "startPage": "26",
        "endPage": "29",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
