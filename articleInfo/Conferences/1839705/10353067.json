        "articleTitle": "A Stitch in Time: Using Data Embroidery to Tell Australian Convict Stories",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "6",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
