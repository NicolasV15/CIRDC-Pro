        "articleTitle": "Do Words Matter: Visualising Historical Policy and Media Narratives around Opportunity and Disadvantage in Australia",
        "volume": null,
        "issue": null,
        "startPage": "7",
        "endPage": "12",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
