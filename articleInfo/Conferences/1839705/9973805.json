        "articleTitle": "Boundaries, Extensions, and Challenges of Visualization for Humanities Data: Reflections on Three Cases",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "5",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2022 IEEE 7th Workshop on Visualization for the Digital Humanities (VIS4DH)",
