        "publicationYear": "2005",
        "publicationDate": "28-28 Nov. 2005",
        "articleNumber": "1574585",
        "articleTitle": "Autonomy: beyond OODA?",
        "volume": null,
        "issue": null,
        "startPage": "6 pp.",
        "endPage": null,
