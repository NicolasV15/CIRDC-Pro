        "publicationYear": "2005",
        "publicationDate": "28-28 Nov. 2005",
        "articleNumber": "1574590",
        "articleTitle": "Collaborating multi robotic agents for operations in inaccessible environments",
        "volume": null,
        "issue": null,
        "startPage": "9 pp.",
        "endPage": null,
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "2005 The IEE Forum on Autonomous Systems (Ref. No. 2005/11271)",
        "authors": [
            {
                "id": null,
