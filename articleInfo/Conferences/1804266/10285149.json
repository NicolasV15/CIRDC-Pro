        "articleTitle": "A Low-Noise Low-Power Inductor-Less Self- Biased 50 Gbps TIA in 130nm SiGe BiCMOS",
        "volume": null,
        "issue": null,
        "startPage": "10",
        "endPage": "13",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2023 Austrochip Workshop on Microelectronics (Austrochip)",
        "authors": [
            {
                "id": 37085556646,
