        "articleTitle": "On Analysis of Software Interrupt Limiters for Embedded Systems by Means of UPPAAL SMC",
        "volume": null,
        "issue": null,
        "startPage": "45",
        "endPage": "50",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
