        "articleNumber": "7814004",
        "articleTitle": "Advanced Pseudo Differential Amplifier with Output Common Mode Regulation and Phase Shift Retention",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "6",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
