        "articleTitle": "Initial Steps in Analyzing Science Gateways Sustainability through Business Model Canvas: A Use Case for the Computational Neuroscience Gateway",
        "volume": null,
        "issue": null,
        "startPage": "5",
        "endPage": "8",
