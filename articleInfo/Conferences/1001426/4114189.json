        "articleTitle": "Product Design and the Reasonable Person - Nature versus Nurture?",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "3",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2006 IEEE Symposium on Product Safety Engineering",
        "authors": [
            {
