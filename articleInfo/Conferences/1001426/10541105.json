        "articleTitle": "Developing the Dynamic Hazard-Based Safety Engineering (D-HBSE) by Introducing the Control-Oriented Model",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "8",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2024 IEEE International Symposium on Product Compliance Engineering (ISPCE)",
        "authors": [
            {
                "id": 37089967791,
                "preferredName": "Shun Zhang",
                "firstName": "Shun",
                "lastName": "Zhang"
            },
            {
                "id": 37089951557,
