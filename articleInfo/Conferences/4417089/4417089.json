        "doi": null,
        "publicationYear": "2007",
        "publicationDate": "7-8 Nov. 2007",
        "articleNumber": "4417098",
        "articleTitle": "Earthing & Bonding on the Underground",
        "volume": null,
        "issue": null,
        "startPage": "1",
