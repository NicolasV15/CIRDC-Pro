        "articleTitle": "Integrated grip switching and grasp control for prosthetic hands using fused inertial and mechanomyography measurement",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "8",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2015 Swarm/Human Blended Intelligence Workshop (SHBI)",
        "authors": [
            {
                "id": 37085470231,
