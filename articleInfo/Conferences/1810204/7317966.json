        "articleTitle": "Human swarming, a real-time method for parallel distributed intelligence",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "7",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2015 Swarm/Human Blended Intelligence Workshop (SHBI)",
