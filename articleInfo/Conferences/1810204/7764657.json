        "articleTitle": "Crowds vs swarms, a comparison of intelligence",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "4",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2016 Swarm/Human Blended Intelligence Workshop (SHBI)",
