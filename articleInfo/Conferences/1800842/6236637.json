        "articleNumber": "6248131",
        "articleTitle": "EMC test site validations for 1m automotive and military emissions tests",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "6",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2011 Electromagnetic Compatibility Symposium - Perth",
