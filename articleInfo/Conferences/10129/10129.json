    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050523",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514721",
        "articleTitle": "Identifying safety functions using HAZOP",
        "volume": null,
        "issue": null,
        "startPage": "6",
        "endPage": "6/16",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "C. Easton",
                "firstName": "C.",
                "lastName": "Easton"
            }
        ],
        "abstract": "Key to the process of SIL determination is the identification of hazards; causes, consequences and frequencies that lead the study team to propose safety functions to reduce the risk of the hazard being realized. HAZOP is a popular and reasonably well understood tool that supports this process and when an audit trail can be created that automatically links the HAZOP SIF output to the SIL determination study then cost and time savings can be achieved. This presentation reviews a recent project completed in Romania working with Honeywell and PETROM utilizing the AIM SILHAZOP and SILClass software tools for the study of the Arpechim refinery as a part of a Euro 20 Million DCS upgrade project. The presentation will discuss the positive and negative aspects of the exercise, the learning experiences and the cost and time savings that have been realized by PETROM as a result of using the software based tools",
        "keywords": {
            "Index Terms": [
                "Hazardous Effects"
            ]
        }
    },
    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050521",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514717",
        "articleTitle": "SIL determination - an iterative journey",
        "volume": null,
        "issue": null,
        "startPage": "4",
        "endPage": "4/15",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "C. Howard",
                "firstName": "C.",
                "lastName": "Howard"
            },
            {
                "id": null,
                "preferredName": "G. Taylor",
                "firstName": "G.",
                "lastName": "Taylor"
            }
        ],
        "abstract": "The process of SIL determination is a major area of change in the use of safety instrumented systems. The changes involve people, technical and procedural issues; and introduce requirements where there is uncertainty and limitations in current knowledge. This paper explores the development of a formal SIL determination process for a large existing facility and the lessons that have been learnt",
        "keywords": {}
    },
    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050522",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514719",
        "articleTitle": "Horses for courses",
        "volume": null,
        "issue": null,
        "startPage": "5",
        "endPage": "5/21",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "Clive Timms",
                "firstName": "Clive",
                "lastName": "Timms"
            },
            {
                "id": null,
                "preferredName": "John Loomes",
                "firstName": "John",
                "lastName": "Loomes"
            }
        ],
        "abstract": "A joint presentation, with a typical end user, examining the process of introducing and adopting tools to aid alarm management, SIL determination and SIF design cost optimisation. It will review the objectives and some experiences for reducing the effort of trying to achieve compliance with IEC 61508/61511, from an end users perspective",
        "keywords": {
            "Index Terms": [
                "Horses For Courses"
            ]
        }
    },
