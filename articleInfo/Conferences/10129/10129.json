    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050518",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514712",
        "articleTitle": "SIL determination requirements and problem areas",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "1/15",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "B. Black",
                "firstName": "B.",
                "lastName": "Black"
            }
        ],
        "abstract": "SIL determination is often carried out using the methods defined in Part 5 of IEC 61508. The requirements in part 1 are often ignored and this can lead to implementation problems. The paper presented discussed a number of common problems and propose approaches to simplify functions and reduce costs",
        "keywords": {
            "Index Terms": [
                "Demand Rate"
            ]
        }
    },
    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050519",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514714",
        "articleTitle": "The transition from risk graphs to LOPA and the timing of hazard and risk analysis",
        "volume": null,
        "issue": null,
        "startPage": "2",
        "endPage": "2/17",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "C. Charnock",
                "firstName": "C.",
                "lastName": "Charnock"
            }
        ],
        "abstract": "The presentation is intended to share our practical experience of utilizing risk graphs in the hazard & risk analysis process and their associated pitfalls. Further to this; how we have adopted the layer of protection analysis approach to address the issues associated with risk graphs. Finally, we have observed difficulties in the appropriate timing of SIL determination and the presentation is intended to outline how this can be optimized",
        "keywords": {}
    },
    {
        "publicationNumber": "10129",
        "doi": "10.1049/ic:20050520",
        "publicationYear": "2005",
        "publicationDate": "5-5 April 2005",
        "articleNumber": "1514716",
        "articleTitle": "Operator experience of SIL determination in the offshore oil and gas industry",
        "volume": null,
        "issue": null,
        "startPage": "3",
        "endPage": "3/8",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Seminar on Methods and Tools for SIL Determinationa 2005 (Ref. No. 2005/10986)",
        "authors": [
            {
                "id": null,
                "preferredName": "M. Currie",
                "firstName": "M.",
                "lastName": "Currie"
            }
        ],
        "abstract": "Risk graphs are widely used for SIL determination but are known to be conservative. LOPA (layer of protection analysis) is more rigorous and takes longer to carry out. The two methods will be compared using examples and a strategy is proposed for using the strengths of both methods",
        "keywords": {
            "Index Terms": [
                "Gas Industry",
                "Unbounded Search"
            ]
        }
    },
