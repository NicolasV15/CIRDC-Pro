        "articleTitle": "A Low-Rank Tensor Completion Approach for Imputing Functional Neuronal Data from Multiple Recordings",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "6",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
