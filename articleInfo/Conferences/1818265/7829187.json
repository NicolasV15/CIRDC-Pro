        "articleTitle": "Methodology and Application of HPC: I/O Characterization with MPIProf and IOT",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "8",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2016 5th Workshop on Extreme-Scale Programming Tools (ESPT)",
        "authors": [
            {
                "id": 37086175749,
