        "articleTitle": "ROMoSu: Flexible Runtime Monitoring Support for ROS-based Applications",
        "volume": null,
        "issue": null,
        "startPage": "53",
        "endPage": "60",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2023 IEEE/ACM 5th International Workshop on Robotics Software Engineering (RoSE)",
        "authors": [
