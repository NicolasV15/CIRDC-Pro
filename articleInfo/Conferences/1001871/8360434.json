        "articleTitle": "Machine Learning Based Predictive Maintenance Strategy: A Super Learning Approach with Deep Neural Networks",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "5",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 IEEE Workshop on Microelectronics and Electron Devices (WMED)",
        "authors": [
            {
                "id": 37085771422,
