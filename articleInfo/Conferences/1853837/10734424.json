        "articleNumber": "10734513",
        "articleTitle": "What if Autonomous Systems Had a Game Master? Targeted Explaining With the Help of a Supervisory Control System",
        "volume": null,
        "issue": null,
        "startPage": "15",
        "endPage": "19",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2024 IEEE/ACM Workshop on Explainability Engineering (ExEn)",
        "authors": [
            {
                "id": 37089572917,
