        "articleTitle": "Access Control for Apps Running on Constrained Devices in the Internet of Things",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "9",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2014 International Workshop on Secure Internet of Things",
        "authors": [
            {
                "id": 37085421423,
