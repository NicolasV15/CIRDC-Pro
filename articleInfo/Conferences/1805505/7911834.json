        "startPage": "1",
        "endPage": "10",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2016 International Workshop on Secure Internet of Things (SIoT)",
        "authors": [
            {
                "id": 37086168709,
                "preferredName": "Juan D. Parra Rodriguez",
                "firstName": "Juan D.",
                "lastName": "Parra Rodriguez"
            },
            {
                "id": 37688349900,
