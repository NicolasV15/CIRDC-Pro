        "articleTitle": "Multi Agent DeepRL Based Joint Power and Subchannel Allocation in IAB networks",
        "volume": null,
        "issue": null,
        "startPage": "55",
        "endPage": "61",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
