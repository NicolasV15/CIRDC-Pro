        "articleTitle": "Humanity Test - EEG Data Mediated Artificial Intelligence Multiplayer Interactive System",
        "volume": null,
        "issue": null,
        "startPage": "117",
        "endPage": "124",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
