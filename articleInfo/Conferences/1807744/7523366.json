        "articleTitle": "Area optimization methodology for RFIDs combining capacitors placement within digital circuitry",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "4",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2015 IEEE Brasil RFID",
        "authors": [
