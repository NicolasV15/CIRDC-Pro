        "articleTitle": "Maintaining connectivity in mobile adhoc networks using distributed optimisation",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "6",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2011 Military Communications and Information Systems Conference",
        "authors": [
