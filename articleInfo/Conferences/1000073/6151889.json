        "articleTitle": "Modeling and simulation of a manycore PCR-CE lab-on-chip for DNA sequencing using SystemC/SystemC-AMS",
        "volume": null,
        "issue": null,
        "startPage": "63",
        "endPage": "68",
        "publisher": "IEEE",
