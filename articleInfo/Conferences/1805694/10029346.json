        "articleTitle": "GPU-Accelerated Sparse Matrix Vector Product based on Element-by-Element Method for Unstructured FEM using OpenACC",
        "volume": null,
        "issue": null,
        "startPage": "52",
        "endPage": "61",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2022 Workshop on Accelerator Programming Using Directives (WACCPD)",
        "authors": [
