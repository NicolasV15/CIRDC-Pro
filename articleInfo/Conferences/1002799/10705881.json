        "articleTitle": "Impact of Data Compression on Downstream AI Tasks: A Study using Teleoperated Driving over 5G",
        "volume": null,
        "issue": null,
        "startPage": "25",
        "endPage": "30",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2024 IEEE International Workshop Technical Committee on Communications Quality and Reliability (CQR)",
        "authors": [
