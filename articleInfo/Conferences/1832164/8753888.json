        "articleTitle": "Energy Access in Community Microgrids based on Decentralized Real-time Pricing",
        "volume": null,
        "issue": null,
        "startPage": "206",
        "endPage": "212",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2019 IEEE Decentralized Energy Access Solutions Workshop (DEAS)",
        "authors": [
