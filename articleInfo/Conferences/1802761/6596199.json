        "articleTitle": "Concept to commit: A pattern designed to trace code changes from user requests to change implementation by analyzing mailing lists and code repositories",
        "volume": null,
        "issue": null,
        "startPage": "6",
        "endPage": "8",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2013 1st International Workshop on Data Analysis Patterns in Software Engineering (DAPSE)",
        "authors": [
            {
                "id": 38525457900,
