        "articleTitle": "A Roadmap for Ethics-Aware Software Engineering",
        "volume": null,
        "issue": null,
        "startPage": "15",
        "endPage": "21",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 IEEE/ACM International Workshop on Software Fairness (FairWare)",
        "authors": [
