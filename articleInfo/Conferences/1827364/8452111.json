        "articleTitle": "Integrating Social Values into Software Design Patterns",
        "volume": null,
        "issue": null,
        "startPage": "8",
        "endPage": "14",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 IEEE/ACM International Workshop on Software Fairness (FairWare)",
        "authors": [
            {
                "id": 37089141448,
