        "articleNumber": "8760369",
        "articleTitle": "Adaptive Crawling in Online Social Networks: a Matrix Factorization Based Approach",
        "volume": null,
        "issue": null,
        "startPage": "207",
        "endPage": "212",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 International Symposium on Security and Privacy in Social Networks and Big Data (SocialSec)",
        "authors": [
            {
                "id": 37086051174,
