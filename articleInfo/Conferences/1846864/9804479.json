        "articleTitle": "Implementing Optimization-Based Control Tasks in Cyber-Physical Systems With Limited Computing Capacity",
        "volume": null,
        "issue": null,
        "startPage": "15",
        "endPage": "16",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2022 2nd International Workshop on Computation-Aware Algorithmic Design for Cyber-Physical Systems (CAADCPS)",
        "authors": [
            {
                "id": 37086442144,
                "preferredName": "Mehdi Hosseinzadeh",
                "firstName": "Mehdi",
                "lastName": "Hosseinzadeh"
            },
            {
                "id": 37265687500,
