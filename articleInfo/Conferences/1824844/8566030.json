        "articleTitle": "Design of the Cost Effective Execution Worker Scheduling Algorithm for FaaS Platform Using Two-Step Allocation and Dynamic Scaling",
        "volume": null,
        "issue": null,
        "startPage": "131",
        "endPage": "134",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 IEEE 8th International Symposium on Cloud and Service Computing (SC2)",
        "authors": [
