        "articleTitle": "An application-specific NBTI ageing analysis method",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "4",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2015 International Workshop on CMOS Variability (VARI)",
        "authors": [
            {
                "id": 37085806534,
