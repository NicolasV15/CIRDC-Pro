        "volume": null,
        "issue": null,
        "startPage": "17",
        "endPage": "18",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "IEEE/LEOS Workshop on Advanced Modulation Formats, 2004",
        "authors": [
            {
                "id": 37087782529,
                "preferredName": "G. Funatsu",
                "firstName": "G.",
                "lastName": "Funatsu"
            },
            {
                "id": 37275329700,
