        "articleTitle": "40-Gb/s upgradability of 10-GB/S systems",
        "volume": null,
        "issue": null,
        "startPage": "23",
        "endPage": "24",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "IEEE/LEOS Workshop on Advanced Modulation Formats, 2004",
        "authors": [
            {
                "id": 37270274200,
                "preferredName": "P. Mamyshev",
                "firstName": "P.",
                "lastName": "Mamyshev"
            },
            {
                "id": 37085913595,
