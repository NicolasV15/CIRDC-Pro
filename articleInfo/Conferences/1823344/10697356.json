        "articleTitle": "Ensuring Fairness with Transparent Auditing of Quantitative Bias in AI Systems",
        "volume": null,
        "issue": null,
        "startPage": "25",
        "endPage": "32",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2024 Pacific Neighborhood Consortium Annual Conference and Joint Meetings (PNC)",
        "authors": [
            {
                "id": 748920133883736,
