        "articleTitle": "Low dose rate radiation testing of advanced CMOS technology (AC/ACT) series parts for space flight applications",
        "volume": null,
        "issue": null,
        "startPage": "53",
        "endPage": "57",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "Workshop Record 1992 IEEE Radiation Effects Data Workshop",
        "authors": [
            {
