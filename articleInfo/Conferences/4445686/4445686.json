        "publicationYear": "2007",
        "publicationDate": "23-23 Nov. 2007",
        "articleNumber": "4449035",
        "articleTitle": "ASTRAEA T7 — An architectural outline for system health management on civil UAVs",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "4",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "2007 Institution of Engineering and Technology Conference on Autonomous Systems",
        "authors": [
            {
                "id": null,
                "preferredName": "Clive G. Downes",
                "firstName": "Clive G.",
                "lastName": "Downes"
            }
        ],
        "abstract": "The ASTRAEA programme has as its aim the opening of unsegregated airspace to UAV traffic, allowing UAVs to routinely perform tasks currently undertaken by manned vehicles. Within this programme the aim of the Prognostics and Health Management project (T7) is to provide technology and systems so that a UAV can monitor its own state, perform real-time prognoses of its immediate and future capabilities, make decisions on how best to assist the optimal mission performance and adapt its behaviour accordingly. This technology area is seen as critical to the safe operation of a UAV in the un-segregated airspace. This paper details the relationship of the T7 project within the ASTRAEA programme and describes an architectural outline within which to develop, investigate and demonstrate civil UAV systems health management.",
        "keywords": {
            "Index Terms": [
                "Health Management",
                "Unmanned Aerial Vehicles",
                "Future Capabilities",
                "Remaining Useful Life",
                "Lower Layer",
                "Situational Awareness",
                "Flight Conditions",
                "Temporal Horizon",
                "Flight Mode"
            ],
            "Author Keywords": [
                "UAV",
                "PHM",
                "Autonomy",
                "Open Architecture"
            ]
        }
    },
