        "articleTitle": "Cooperative control strategies for swarm of unmanned aerial vehicles under motion uncertainty",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "5",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "2007 Institution of Engineering and Technology Conference on Autonomous Systems",
        "authors": [
            {
                "id": null,
                "preferredName": "A. Tsourdos",
                "firstName": "A.",
                "lastName": "Tsourdos"
            },
            {
                "id": null,
