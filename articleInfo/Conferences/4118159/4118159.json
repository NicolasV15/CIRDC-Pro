    {
        "publicationNumber": "4118159",
        "doi": null,
        "publicationYear": "2006",
        "publicationDate": "5 Dec.-5 Nov. 2006",
        "articleNumber": "4118180",
        "articleTitle": "The Impact of Changing Technology",
        "volume": null,
        "issue": null,
        "startPage": "19",
        "endPage": "28",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The Institution of Engineering and Technology Seminar on Railway Human Factors in a Changing World",
        "authors": [
            {
                "id": null,
                "preferredName": "Gary Davis",
                "firstName": "Gary",
                "lastName": "Davis"
            }
        ],
        "abstract": "A change is as good as a rest, or so they say. But if not properly managed, changes in technology can have serious negative effects on railway customers and staff. Technology changes can deliver real benefits in terms of safety, cost efficiencies and service improvements but it is essential that human factors are considered throughout the inception, design and implementation process. This paper describes industry best practice and illustrates good and bad examples of the impact of technology change",
        "keywords": {
            "Index Terms": [
                "Good And Bad",
                "Example Of The Impact",
                "Bad Example"
            ]
        }
    },
    {
        "publicationNumber": "4118159",
        "doi": null,
        "publicationYear": "2006",
        "publicationDate": "5 Dec.-5 Nov. 2006",
        "articleNumber": "4118178",
        "articleTitle": "Changing Standards",
        "volume": null,
        "issue": null,
        "startPage": "3",
        "endPage": "18",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The Institution of Engineering and Technology Seminar on Railway Human Factors in a Changing World",
        "authors": [
            {
                "id": null,
                "preferredName": "Amanda Elliot",
                "firstName": "Amanda",
                "lastName": "Elliot"
            }
        ],
        "abstract": "This paper discusses standards and their inevitable changes in development and use. The conjecture is that rail human factors standards were once developed to raise awareness in nonexperts, are now being used by experts but in future will go full-circle to be used by a wider audience of systems engineers in the years to come. Human factors should aim to become truly integrated with rail systems standards. This will necessitate changes in the HF standards from the current emphasis on process and techniques to the importance of re-use of research, previous studies and appropriate designs",
        "keywords": {
            "Index Terms": [
                "Ergonomic"
            ]
        }
    },
    {
