        "articleTitle": "On Reducing Network Usage with Genetic Improvement",
        "volume": null,
        "issue": null,
        "startPage": "23",
        "endPage": "30",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2024 IEEE/ACM International Workshop on Genetic Improvement (GI)",
        "authors": [
