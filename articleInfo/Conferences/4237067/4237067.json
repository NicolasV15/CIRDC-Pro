        "articleNumber": "4237081",
        "articleTitle": "BT 21st Century Network Water Industry Impact",
        "volume": null,
        "issue": null,
        "startPage": "19",
        "endPage": "26",
        "publisher": "IET",
        "articleContentType": "Conferences",
