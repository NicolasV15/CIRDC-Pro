    {
        "publicationNumber": "4237067",
        "doi": null,
        "publicationYear": "2007",
        "publicationDate": "24-25 April 2007",
        "articleNumber": "4237096",
        "articleTitle": "Centralised Outstation Configuration Management and Control in the Utilities Sector",
        "volume": null,
        "issue": null,
        "startPage": "113",
        "endPage": "127",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "2007 IET Water Event",
        "authors": [
            {
                "id": null,
                "preferredName": "Chris Knipe",
                "firstName": "Chris",
                "lastName": "Knipe"
            }
        ],
        "abstract": "As business relies more and more on systems like data warehouses and business intelligence (Bl) presented through dashboards, there comes with this an inherent and increasing risk. (1) Do you really trust the information presented to you? (2) Do you really know where it came from? (3) Do you really know what you would do about it if it as wrong? (4) Do you really know it is accurate? Bl now looks to source its underlying data from many disparate systems, including real-time and historic telemetry data, which by its very nature is an order of magnitude more complex in management than it's pure IT based equivalent. This presentation provides an overview of the approach Capula and Southern Water took to address these issues, culminating in the development of Capula Oneview. We look at the identification and scoping of the problem, the development of the solution and the realisation of the benefits.",
        "keywords": {
            "Index Terms": [
                "Audit Trial",
                "Protection Of Reputation"
            ]
        }
    },
