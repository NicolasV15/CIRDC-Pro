        "startPage": "1",
        "endPage": "1",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "IET IPTV Conference 2007 - Deployment and Service Delivery",
        "authors": [
            {
                "id": null,
                "preferredName": "Mike Short",
                "firstName": "Mike",
                "lastName": "Short"
            }
        ],
        "abstract": "Mobile from a verbal to a visual world the importance of the 4th screen of Mobile is growing — this is no longer just text and Mobile Email. This will grow in Mobile Video and Games, and evolve through Mobile Internet to Mobile TV. The characteristics of who does what and cost effectiveness will change in contrast to traditional Broadcasting models, whether through global reach, Content licensing processes or Mobile advertising. “IP TV on the move” explores these issues and opportunities.",
        "keywords": {}
    },
    {
        "publicationNumber": "4446773",
        "doi": null,
        "publicationYear": "2007",
        "publicationDate": "13-13 Dec. 2007",
        "articleNumber": "4451694",
        "articleTitle": "About the speaker",
        "volume": null,
        "issue": null,
