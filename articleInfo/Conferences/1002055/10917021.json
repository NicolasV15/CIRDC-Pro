        "articleTitle": "GPMAPPO: Collaborative SAR Optimization of Human-UAV in Post-Disaster Scenarios",
        "volume": null,
        "issue": null,
        "startPage": "17",
        "endPage": "24",
        "publisher": "IEEE",
