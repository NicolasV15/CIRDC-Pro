        "articleTitle": "A holistic solution for reliable over-the-air software updates in large industrial plants",
        "volume": null,
        "issue": null,
        "startPage": "29",
        "endPage": "34",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2017 13th Workshop on Intelligent Solutions in Embedded Systems (WISES)",
        "authors": [
