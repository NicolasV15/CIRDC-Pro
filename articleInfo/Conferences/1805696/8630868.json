        "articleTitle": "Non-collective Scalable Global Network Based on Local Communications",
        "volume": null,
        "issue": null,
        "startPage": "25",
        "endPage": "32",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2018 IEEE/ACM 9th Workshop on Latest Advances in Scalable Algorithms for Large-Scale Systems (scalA)",
        "authors": [
            {
                "id": 37086452773,
                "preferredName": "Marco Berghoff",
