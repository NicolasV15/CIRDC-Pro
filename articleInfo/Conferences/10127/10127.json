        "issue": null,
        "startPage": "10",
        "endPage": "20",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Storage and Home Networks Seminar, 2004.",
        "authors": [
            {
                "id": null,
                "preferredName": "D. White",
                "firstName": "D.",
                "lastName": "White"
            }
        ],
        "abstract": "TV-Anytime has been integrated into DVB. TV-Anytime provides data model based on content (i) Programmes describes items of content. (ii) Groups describe collections (e.g. series). (iii) Segmentation defines navigation within content. TV-Anytime also provides content identification and content resolution.",
        "keywords": {}
