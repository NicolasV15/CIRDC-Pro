    {
        "publicationNumber": "10127",
        "doi": "10.1049/ic:20040550",
        "publicationYear": "2004",
        "publicationDate": "3-3 Nov. 2004",
        "articleNumber": "1514279",
        "articleTitle": "Metadata - the role of the TV-Anytime specification",
        "volume": null,
        "issue": null,
        "startPage": "32",
        "endPage": "40",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Storage and Home Networks Seminar, 2004.",
        "authors": [
            {
                "id": null,
                "preferredName": "C. Morecraft",
                "firstName": "C.",
                "lastName": "Morecraft"
            }
        ],
        "abstract": "There is a growing need for high quality TV and radio metadata. In order to meet the requirements of all the actors in the value chain, and the challenge of proliferating digital content distribution networks and devices, there is a strong need for metadata interoperability. The TV-Anytime metadata specification provides rich functionality to enable interoperability. It is available now for implementation in the broadcast environment.",
        "keywords": {
            "Index Terms": [
                "Metadata",
                "Digital Content"
            ]
        }
    },
    {
        "publicationNumber": "10127",
        "doi": "10.1049/ic:20040552",
        "publicationYear": "2004",
        "publicationDate": "3-3 Nov. 2004",
        "articleNumber": "1514283",
        "articleTitle": "Analogue switch-off and its implications",
        "volume": null,
        "issue": null,
        "startPage": "108",
        "endPage": "116",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "The IEE Storage and Home Networks Seminar, 2004.",
        "authors": [
            {
                "id": null,
                "preferredName": "P. Marshall",
                "firstName": "P.",
                "lastName": "Marshall"
            }
        ],
        "abstract": "We plan to convert three analogue networks to digital. These three PSB networks have high power and 1100 relay stations to achieve - 97% coverage. Three commercial digital networks use the best of the rest and up to 200 relays. 14 uhf channels in two bands cleared for re-use. There is enormous support for DHWG standards based on Ethernet/UDDP/802.11x. Content management offers lots of new business opportunities.",
        "keywords": {}
    },
    {
        "publicationNumber": "10127",
        "doi": "10.1049/ic:20040548",
        "publicationYear": "2004",
        "publicationDate": "3-3 Nov. 2004",
        "articleNumber": "1514270",
        "articleTitle": "Implementing TV-Anytime on DVB",
