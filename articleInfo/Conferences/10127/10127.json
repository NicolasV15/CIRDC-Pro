        "authors": [
            {
                "id": null,
                "preferredName": "B. Bissell",
                "firstName": "B.",
                "lastName": "Bissell"
            }
        ],
        "abstract": "Broadband ISPs provided a USB modem, which enabled connection to a single PC only. BT now provide a router as standard to new 'BT Broadband' and 'BT Yahoo! Broadband' customers. It provides customers better value of money. Broadband supplies data to (and from) the home and the home network distributes it to point of consumption.",
        "keywords": {
            "Index Terms": [
                "Home Network"
            ]
        }
    }
