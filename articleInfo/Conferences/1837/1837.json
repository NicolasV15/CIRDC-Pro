        "volume": null,
        "issue": null,
        "startPage": "4/1",
        "endPage": "4/4",
        "publisher": "IET",
        "articleContentType": "Conferences",
        "publicationTitle": "IEE Colloquium on Applications of Quantum Wells in Optoelectronics",
        "authors": [
