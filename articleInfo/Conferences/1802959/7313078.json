        "articleTitle": "Slovenian FTTH deployments before and after the economic crisis",
        "volume": null,
        "issue": null,
        "startPage": "6",
        "endPage": "10",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2015 International Workshop on Fiber Optics in Access Network (FOAN)",
        "authors": [
            {
