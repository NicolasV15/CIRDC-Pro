        "articleTitle": "Plotting a Course Down the Winding Road of Social Media in the Pulp and Paper Industry",
        "volume": null,
        "issue": null,
        "startPage": "74",
        "endPage": "86",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
