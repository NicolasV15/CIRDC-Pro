        "articleTitle": "Using indexed sequence diagrams to recover the behaviour of AJAX applications",
        "volume": null,
        "issue": null,
        "startPage": "1",
        "endPage": "10",
        "publisher": "IEEE",
        "articleContentType": "Conferences",
        "publicationTitle": "2011 13th IEEE International Symposium on Web Systems Evolution (WSE)",
        "authors": [
            {
                "id": 37411436100,
                "preferredName": "Shane McIntosh",
                "firstName": "Shane",
                "lastName": "McIntosh"
            },
            {
                "id": 37309862300,
